# ARCHIVO DE EJEMPLO DE CONFIGURACIÓN
# Copia este archivo a ".env" y personaliza los valores según tu entorno

# --- OCR (Reconocimiento Óptico de Caracteres) ---
# Motor OCR a utilizar
OCR_ENGINE=tesseract

# Ruta al ejecutable de Tesseract
# Windows (ejemplo): C:\Program Files\Tesseract-OCR\tesseract.exe
# Linux/Mac (si está en PATH): tesseract
TESSERACT_PATH=tesseract

# Idiomas para OCR, separados por +
# eng = Inglés, spa = Español
OCR_LANGUAGES=eng+spa

# --- NLP (Procesamiento de Lenguaje Natural) ---
# Idioma predeterminado para análisis de texto
# eng = Inglés, spa = Español
DEFAULT_NLP_LANGUAGE=eng

# --- API ---
# Dirección IP donde escuchar (0.0.0.0 = todas las interfaces)
API_HOST=0.0.0.0

# Puerto para la API
API_PORT=8000

# Modo de depuración (True/False)
API_DEBUG=False

# --- LOGS ---
# Nivel de detalle de los registros (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO
